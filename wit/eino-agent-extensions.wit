package eino-agent:extensions@0.2.0;

interface types {
  record structured-error {
    code: string,
    message: string,
    retryable: bool,
  }

  record role-counts {
    system: u32,
    user: u32,
    assistant: u32,
    tool: u32,
  }

  /// A deliberately bounded projection of runtime.TurnSnapshot. It never
  /// contains config maps, resolved model clients, credentials, endpoints,
  /// raw provider payloads, or conversation content.
  record turn-metadata {
    run-id: string,
    session-id: string,
    epoch-id: string,
    agent-name: string,
    agent-mode: string,
    provider-id: string,
    model-id: string,
    tool-names: list<string>,
    message-count: u32,
    role-counts: role-counts,
    has-system-prompt: bool,
  }

  record tool-metadata {
    name: string,
    description: string,
    /// A JSON Schema document. Hosts validate syntax and configured bounds.
    parameters-json-schema: string,
    retry-safe: bool,
    required-permissions: list<string>,
  }

  enum permission-action {
    allow,
    deny,
    ask,
  }

  record permission-request {
    tool-name: string,
    tool-call-id: string,
    permission: string,
    /// A bounded summary derived from the final, rewritten arguments.
    arguments-summary: string,
    session-id: string,
    run-id: string,
  }

  record permission-decision {
    action: permission-action,
    reason: string,
  }

  enum text-role {
    system,
    user,
  }

  /// A bounded reference to non-text content (image, audio, video, file):
  /// never a raw payload, always a URI a trusted host resolves. uri and
  /// mime-type are both required.
  record media-reference {
    uri: string,
    mime-type: string,
  }

  /// A function/tool call the model issued, projected for observation only
  /// -- carries no execution authority; arguments-json is a normalized JSON
  /// document.
  record function-call-block {
    call-id: string,
    name: string,
    arguments-json: string,
  }

  /// A settled function/tool result's text projection. Never the raw
  /// durable settlement: a bounded, model-visible text view only.
  record function-result-text-block {
    call-id: string,
    text: string,
  }

  /// content-block is the versioned successor to the removed text-message
  /// record: a message is now an ordered list of typed blocks instead of a
  /// single flat string, so context-source (and any future WASM context/
  /// model/tool middleware observing message content) can see and produce
  /// media references and call/result projections without flattening them
  /// to text. Adding a new case is a breaking change to this variant and
  /// requires a new world version (see the eino-agent:extensions package
  /// version below); a host on a newer version refuses a guest built
  /// against an older one at component-instantiation time (the Component
  /// Model's own canonical-ABI type check on the exported function
  /// signature already enforces this structurally -- a size/shape
  /// mismatch on this variant's cases fails linking, not a crash), never
  /// silently misinterpreting an unknown case's payload.
  variant content-block {
    text(string),
    media-reference(media-reference),
    function-call(function-call-block),
    function-result-text(function-result-text-block),
  }

  /// message replaces text-message: role plus an ordered list of typed
  /// content-block values instead of one flat text field.
  record message {
    role: text-role,
    blocks: list<content-block>,
  }

  record bounded-event {
    kind: string,
    session-id: string,
    run-id: string,
    message-id: string,
    tool-call-id: string,
    epoch-id: string,
    timestamp-unix-millis: s64,
    /// A host-produced bounded payload summary, never a raw provider payload.
    payload-summary: string,
  }

  variant replacement {
    unchanged,
    json(string),
    error(structured-error),
  }
}

interface tool-api {
  use types.{structured-error, tool-metadata, turn-metadata};

  metadata: func() -> result<tool-metadata, structured-error>;
  /// Derives the permission identity from final normalized tool input. This
  /// value is evaluated by the host policy; it is not an authorization result.
  permission-pattern: func(input-json: string) -> result<string, structured-error>;
  /// Input and output are normalized JSON documents whose byte bounds are
  /// enforced by the host on both sides of this call.
  execute: func(tool-call-id: string, input-json: string, turn: turn-metadata) -> result<string, structured-error>;
}

interface permissions-policy-api {
  use types.{permission-decision, permission-request, structured-error};

  decide: func(request: permission-request) -> result<permission-decision, structured-error>;
}

interface context-source-api {
  use types.{structured-error, message, turn-metadata};

  load-context: func(turn: turn-metadata) -> result<list<message>, structured-error>;
}

interface event-sink-api {
  use types.{bounded-event, structured-error};

  emit: func(event: bounded-event) -> result<_, structured-error>;
}

interface hook-api {
  use types.{structured-error, turn-metadata};

  before-run: func(snapshot: turn-metadata) -> result<_, structured-error>;
  after-run: func(snapshot: turn-metadata) -> result<_, structured-error>;
}

interface tool-middleware-api {
  use types.{replacement, turn-metadata};

  before-tool-call: func(tool-name: string, tool-call-id: string, input-json: string, turn: turn-metadata) -> replacement;
  after-tool-call: func(tool-name: string, tool-call-id: string, executed-input-json: string, output-json: string, turn: turn-metadata) -> replacement;
}

world tool {
  import eino-agent:host/log@0.1.0;
  export tool-api;
}

world permissions-policy {
  import eino-agent:host/log@0.1.0;
  export permissions-policy-api;
}

world context-source {
  import eino-agent:host/log@0.1.0;
  export context-source-api;
}

world event-sink {
  import eino-agent:host/log@0.1.0;
  export event-sink-api;
}

world hook {
  import eino-agent:host/log@0.1.0;
  export hook-api;
}

world tool-middleware {
  import eino-agent:host/log@0.1.0;
  export tool-middleware-api;
}
